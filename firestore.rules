rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Public ambassador roster: client read-only (for re-login result display)
    match /ambassadors_public/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Killer / secret fields: Admin SDK only
    match /ambassadors_secret/{id} {
      allow read, write: if false;
    }

    // One-time check-in PINs: Admin SDK only
    match /checkin_codes/{id} {
      allow read, write: if false;
    }

    // Role pool + killer quota: admin read, Admin SDK write
    match /system_config/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
