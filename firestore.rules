rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Public ambassador roster: client read-only (for re-login result display)
    match /ambassadors_public/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Killer / secret fields: Admin SDK only
    match /ambassadors_secret/{id} {
      allow read, write: if false;
    }

    // One-time check-in PINs: Admin SDK only
    match /checkin_codes/{id} {
      allow read, write: if false;
    }

    // Role pool + killer quota: admin read, Admin SDK write
    // puzzle.answers lives here too — never expose full config to clients
    match /system_config/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Puzzle groups: client read for live progress sync; writes only via Admin SDK
    match /groups/{groupId} {
      allow read: if true;
      allow write: if false;
    }

    // Code → group_id index: Admin SDK only (join looks up via Functions)
    match /group_codes/{code} {
      allow read, write: if false;
    }

    // Player session tokens: Admin SDK only
    match /puzzle_sessions/{token} {
      allow read, write: if false;
    }
  }
}
