# Copy to .env and fill in locally. Do NOT commit .env.

# Firebase project
FIREBASE_PROJECT_ID=nuva-guraduation

# Path to Admin SDK service account JSON (for scripts/seed.js)
# Download from: Firebase Console → Project settings → Service accounts → Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Seed input CSV lives in scripts/data/ambassadors.csv
# Seed output (PIN roster) is written to scripts/output/ (gitignored)

# Optional: override role pool instead of auto 2:1:1 from CSV count
# ROLE_POOL_大力士=46
# ROLE_POOL_品味家=22
# ROLE_POOL_判斷家=22

# Admin email (Phase 3 — Custom Claims allowlist / createAdmin.js)
ADMIN_EMAIL=nuvadmin@gmail.com
# ADMIN_PASSWORD=set-a-strong-password
# Comma-separated allowlist for ensureAdminClaim (also set on Cloud Functions env if needed)
# ADMIN_ALLOWLIST=nuvadmin@gmail.com
